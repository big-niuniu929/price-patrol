{
  "manifest_version": 3,
  "name": "电商平台价格巡检工作台 · 矩阵版（阵列速采）",
  "version": "1.5.0",
  "description": "矩阵版：取价规则与双轨版完全一致（同一份 content.js / 同一套阈值）。新增「矩阵速采」：直接打开多个真实商品页窗口，按屏幕弧线排开批量读取，整批读完后一次性写入、再淡出关闭；也可切换为「后台标签页 + 矩阵大屏」的粉末预演模式。",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://item.shop.example.com/*",
    "http://127.0.0.1:18765/*",
    "https://gateway.example.com/*",
    "http://gateway.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://item.shop.example.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开电商平台价格巡检工作台（矩阵版）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "巡检矩阵版"
}
