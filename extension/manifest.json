{
  "manifest_version": 3,
  "name": "电商平台市占率数据工作台",
  "version": "2.1.7",
  "description": "导入电商平台榜单 Excel，自动补齐尺寸段/价格段/型号/套餐并统计品牌市占率；支持多采样复核、需人工确认、SKU 悬停预览商品页。商品页只读 DOM，数据只存本机，不上传任何服务器。",
  "permissions": ["storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://item.shop.example.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://item.shop.example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开电商平台市占率数据工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
