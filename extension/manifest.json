{
  "manifest_version": 3,
  "name": "电商平台价格巡检工作台",
  "version": "1.0.0",
  "description": "按 SKU 巡检表，批量读取当前电商平台账号（普惠/PLUS 会员）的页面到手价，对照阈值并导出结果。数据只存本机。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://item.shop.example.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://item.shop.example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开电商平台价格巡检工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
