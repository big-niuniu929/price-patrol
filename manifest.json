{
  "manifest_version": 3,
  "name": "价格监控平台 · 电商平台价格与竞品监控三合一",
  "short_name": "价格监控平台",
  "version": "1.1.5",
  "description": "一个入口管三条业务：价格巡检（双轨采集/同品比价）、市场占有率（榜单导入/市占统计）、竞品价格雷达（异动预警/波动看板）。进入后先选业务，界面与原插件一致。数据只存本机。",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://item.shop.example.com/*",
    "https://item.shop.example.com/*",
    "http://127.0.0.1:18765/*",
    "https://gateway.example.com/*",
    "http://gateway.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://item.shop.example.com/*"
      ],
      "js": [
        "modules/patrol/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://item.shop.example.com/*"
      ],
      "js": [
        "modules/share/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://item.shop.example.com/*",
        "https://item.shop.example.com/*"
      ],
      "js": [
        "modules/radar/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开价格监控平台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
